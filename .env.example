# =============================================================================
# .env.example — Variables de entorno del sistema posture-risk
# Sesión 13 del asesor (slide 14):
#   "Archivos .env / config: rutas/keys nunca en código; usar variables de entorno."
#
# Copiar como .env y ajustar según entorno local:
#   cp .env.example .env    (Linux/Mac)
#   copy .env.example .env   (Windows)
#
# IMPORTANTE:
#   - .env NO se sube a git (está en .gitignore)
#   - .env.example SÍ se sube (es la plantilla)
# =============================================================================

# ─── Rutas de artefactos del modelo ──────────────────────────────────────────
MODEL_PATH=models/best_xgb.pkl
CALIBRATORS_PATH=models/calibrators.pkl
THRESHOLDS_PATH=models/thresholds.json

# ─── Datos de ejemplo para E2E y golden test ─────────────────────────────────
SAMPLE_INPUT=data/examples/sample_input.json
E2E_OUTPUT=data/examples/e2e_output.json

# ─── Logs y métricas ─────────────────────────────────────────────────────────
METRICS_CSV=logs/inference_metrics.csv
LOG_LEVEL=INFO
LOG_FORMAT=structured

# ─── Límites operativos (sesión 13, slide 14: seguridad y límites) ───────────
MAX_PAYLOAD_WINDOWS=10000
INFERENCE_TIMEOUT_S=5.0

# ─── Configuración de reproducibilidad ───────────────────────────────────────
SEED=42

# ─── Versionado del sistema ──────────────────────────────────────────────────
MODEL_VERSION=v1.0.0

# ─── Placeholder para futuras integraciones ──────────────────────────────────
# API_HOST=127.0.0.1
# API_PORT=8000
# API_TOKEN=<pendiente-implementación-en-hoja-de-ruta>
